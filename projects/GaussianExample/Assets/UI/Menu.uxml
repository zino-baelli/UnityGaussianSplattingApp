<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MenuStyle.uss?fileID=7433441132597879392&amp;guid=04cb96353bc14b5429d6f49984b47e43&amp;type=3#MenuStyle"/>
    <ui:VisualElement style="flex-grow: 1; height: 100%; max-width: 80%; align-items: center; align-self: center; margin-top: 50px; width: 30%;">
        <ui:Button text="select Input Folder/Video" name="InputSelection" emoji-fallback-support="false"/>
        <ui:Label text="Label" name="InputLabel" style="color: rgb(255, 255, 255);"/>
        <ui:Button text="select output folder" name="OutputSelection"/>
        <ui:Label text="Label" name="OutputLabel" style="color: rgb(255, 255, 255);"/>
        <ui:Foldout text="Settings" enabled="true" toggle-on-label-click="true" value="true" name="SettingsFoldout" style="height: auto; text-overflow: clip; justify-content: flex-start; align-items: stretch; align-self: auto; align-content: flex-start; position: relative; margin-bottom: 20px; width: 100%; min-width: 20%;">
            <ui:DropdownField label="max resolution" name="ResolutionDropdown" style="color: rgb(255, 255, 255);"/>
            <ui:SliderInt label="Iterations" value="1000" high-value="60000" low-value="1000" show-input-field="true" name="IterationSlider" style="max-width: none; width: 100%; min-height: auto; color: rgb(255, 255, 255);"/>
            <ui:SliderInt label="Extraction Framerate" value="2" high-value="12" name="FramerateSlider" low-value="2" fill="true" show-input-field="true" style="max-width: none; width: 100%; min-height: auto; color: rgb(255, 255, 255);"/>
        </ui:Foldout>
        <ui:Button text="Start Training" name="StartButton"/>
        <ui:Label text="Label" name="PipelineStage" style="white-space: normal; color: rgb(255, 255, 255);"/>
        <ui:ProgressBar value="22" title="my-progress" name="StageProgressBar" style="width: 100%;"/>
        <ui:Button text="Cancel Training" name="CancelButton"/>
        <ui:Button text="Import .ply" name="ImportButton"/>
    </ui:VisualElement>
</ui:UXML>
